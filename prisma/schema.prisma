// =============================================================================
// Cuentas API - Esquema de base de datos (Fase 1)
//
// Convenciones del proyecto:
// - Dinero: enteros en centavos (Int). Maximo por campo: $21,474,836.47 MXN.
// - Tasas: puntos base (3699 = 36.99%).
// - Fechas de calendario: String(10) en formato "YYYY-MM-DD".
// - Fechas y horas: DateTime en UTC.
// - "Enums": String validado en la aplicacion (portabilidad SQLite -> MySQL).
// - JSON: String validado con Zod en la aplicacion.
// - Llaves primarias: UUID (String).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Usuarios de la aplicacion. Un usuario es dueno de todos sus registros financieros.
model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                String    @default("USER") // USER | ADMIN
  status              String    @default("PENDING_VERIFICATION") // PENDING_VERIFICATION | ACTIVE | PENDING_DELETION | DELETED
  emailVerifiedAt     DateTime?
  failedLoginCount    Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  deletionRequestedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  settings           UserSettings?
  categories         Category[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  cashAccounts       CashAccount[]
  cashMovements      CashMovement[]
  incomeSources      IncomeSource[]
  incomeSchedules    IncomeSchedule[]
  incomeTransactions IncomeTransaction[]
  recurringExpenses  RecurringExpense[]
  expenses           Expense[]
  creditCards        CreditCard[]
  cardLedgerEntries  CardLedgerEntry[]
  cardStatements     CardStatement[]
  cardPayments       CardPayment[]
  paymentAllocations PaymentAllocation[]
  auditLogs          AuditLog[]          @relation("AuditSubject")
  auditLogsAsActor   AuditLog[]          @relation("AuditActor")
  idempotencyRecords IdempotencyRecord[]

  @@index([status])
  @@index([deletedAt])
}

/// Preferencias financieras y regionales del usuario (1:1 con User).
model UserSettings {
  userId                  String   @id
  timezone                String   @default("America/Mexico_City")
  locale                  String   @default("es-MX")
  holidayCalendarCode     String   @default("MX_BANKING") // MX_BANKING | MX_LABOR
  minCashBuffer           Int      @default(0) // colchon minimo de efectivo, en centavos
  maxUtilizationBps       Int      @default(3000) // 30% de utilizacion recomendada
  variableIncomeFactorBps Int      @default(9000) // ingresos variables al 90%
  pendingIncomeGraceDays  Int      @default(3) // dias de gracia para confirmar un ingreso
  backdateLimitDays       Int      @default(60) // limite de dias hacia atras para movimientos
  projectionMinDays       Int      @default(60) // horizonte minimo de proyeccion
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Categorias de gastos e ingresos. userId nulo = categoria global del sistema.
model Category {
  id        String    @id @default(uuid())
  userId    String?
  parentId  String?
  name      String
  kind      String // EXPENSE | INCOME | BOTH
  icon      String?
  isSystem  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryHierarchy")

  incomeSources     IncomeSource[]
  recurringExpenses RecurringExpense[]
  expenses          Expense[]

  @@index([userId, parentId, name])
  @@index([kind])
}

/// Dias festivos por calendario (MX_LABOR = LFT, MX_BANKING = CNBV).
model Holiday {
  id           String   @id @default(uuid())
  calendarCode String
  date         String // "YYYY-MM-DD"
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([calendarCode, date])
  @@index([calendarCode])
}

/// Bitacora de auditoria de operaciones importantes. Solo insercion.
model AuditLog {
  id          String   @id @default(uuid())
  userId      String? // usuario dueno del recurso afectado
  actorUserId String? // usuario que ejecuto la accion
  action      String
  entityType  String
  entityId    String?
  changes     String? // JSON con antes/despues
  ip          String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime @default(now())

  user  User? @relation("AuditSubject", fields: [userId], references: [id], onDelete: SetNull)
  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Registro de idempotencia para POST financieros (evita duplicados por reintentos).
model IdempotencyRecord {
  id             String   @id @default(uuid())
  userId         String
  key            String
  method         String
  path           String
  requestHash    String
  responseStatus Int
  responseBody   String // JSON
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
}

/// Sesiones activas del usuario. El refresh token se guarda solo como hash.
model Session {
  id                  String    @id @default(uuid())
  userId              String
  familyId            String
  tokenHash           String    @unique
  clientType          String    @default("WEB") // WEB | NATIVE
  deviceName          String?
  ip                  String?
  userAgent           String?
  expiresAt           DateTime
  lastUsedAt          DateTime  @default(now())
  revokedAt           DateTime?
  /// ROTATED | LOGOUT | LOGOUT_ALL | PASSWORD_CHANGED | PASSWORD_RESET | REUSE_DETECTED | DELETION_REQUESTED
  revokedReason       String?
  replacedBySessionId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

/// Tokens de un solo uso para verificar correo o restablecer contrasena (solo hash).
model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

/// Cuentas de efectivo del usuario (efectivo, debito, ahorro). El saldo es cache del libro.
/// Regla RN-04: solo las cuentas isSpendable cuentan para el motor de recomendaciones.
/// Regla RN-05: el saldo jamas se modifica directamente; todo cambio es un CashMovement.
model CashAccount {
  id               String    @id @default(uuid())
  userId           String
  name             String
  type             String    @default("CASH") // CASH | DEBIT | SAVINGS | OTHER
  isSpendable      Boolean   @default(true)
  isDefault        Boolean   @default(false)
  currency         String    @default("MXN")
  /// Cache del libro de movimientos, en centavos.
  currentBalance   Int       @default(0)
  balanceVersion   Int       @default(0)
  status           String    @default("ACTIVE") // ACTIVE | INACTIVE
  lastReconciledAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements  CashMovement[]
  income     IncomeSource[]
  expenses   Expense[]
  recurrences RecurringExpense[]
  cardPayments CardPayment[]

  @@unique([userId, name])
  @@index([userId, deletedAt])
}

/// Libro de movimientos de efectivo: solo insercion. Es la fuente de verdad del saldo.
model CashMovement {
  id                 String   @id @default(uuid())
  userId             String
  cashAccountId      String
  /// Un movimiento solo puede revertirse una vez.
  reversesMovementId String?  @unique
  type               String // OPENING_BALANCE | INCOME | EXPENSE | CARD_PAYMENT | ADJUSTMENT | TRANSFER_IN | TRANSFER_OUT | REVERSAL
  /// Monto con signo en centavos (positivo = entra dinero), distinto de cero.
  amount             Int
  occurredOn         String // "YYYY-MM-DD"
  description        String
  reason             String?
  sourceType         String? // Expense | IncomeTransaction | Transfer | ...
  sourceId           String?
  createdById        String
  createdAt          DateTime @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashAccount CashAccount   @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  reverses    CashMovement? @relation("MovementReversal", fields: [reversesMovementId], references: [id], onDelete: Restrict)
  reversedBy  CashMovement? @relation("MovementReversal")
  expense           Expense?
  incomeTransaction IncomeTransaction?
  cardPayment       CardPayment?

  @@index([userId, cashAccountId, occurredOn])
  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
}

/// Fuente de ingreso del usuario (sueldo, freelance, renta...).
model IncomeSource {
  id              String    @id @default(uuid())
  userId          String
  cashAccountId   String
  categoryId      String?
  name            String
  payer           String?
  amountType      String    @default("FIXED") // FIXED | VARIABLE
  estimatedAmount Int
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashAccount  CashAccount         @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  schedules    IncomeSchedule[]
  transactions IncomeTransaction[]

  @@index([userId, isActive])
}

/// Calendario de pagos de una fuente de ingreso (regla RN-08: quincena 15 y ultimo).
model IncomeSchedule {
  id                 String   @id @default(uuid())
  userId             String
  incomeSourceId     String
  frequency          String // WEEKLY | BIWEEKLY | MONTHLY | CUSTOM | ONE_TIME
  /// Configuracion JSON validada con Zod en la aplicacion.
  config             String
  /// Regla RN-09: PREVIOUS (default) | NEXT | NONE.
  nonBusinessDayRule String   @default("PREVIOUS")
  useHolidays        Boolean  @default(true)
  amountOverride     Int?
  startDate          String // "YYYY-MM-DD"
  endDate            String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeSource IncomeSource        @relation(fields: [incomeSourceId], references: [id], onDelete: Cascade)
  transactions IncomeTransaction[]

  @@index([userId, isActive])
}

/// Confirmacion, omision o reprogramacion de una fecha estimada de ingreso.
model IncomeTransaction {
  id               String   @id @default(uuid())
  userId           String
  incomeSourceId   String
  incomeScheduleId String?
  cashMovementId   String?  @unique
  expectedDate     String?
  expectedAmount   Int?
  actualDate       String?
  actualAmount     Int?
  status           String // CONFIRMED | SKIPPED | RESCHEDULED
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeSource   IncomeSource    @relation(fields: [incomeSourceId], references: [id], onDelete: Cascade)
  incomeSchedule IncomeSchedule? @relation(fields: [incomeScheduleId], references: [id], onDelete: SetNull)
  cashMovement   CashMovement?   @relation(fields: [cashMovementId], references: [id], onDelete: SetNull)

  @@unique([incomeScheduleId, expectedDate])
  @@index([userId, status])
  @@index([userId, actualDate])
}

/// Gasto recurrente programado (renta, servicios, suscripciones).
model RecurringExpense {
  id                 String    @id @default(uuid())
  userId             String
  categoryId         String?
  cashAccountId      String
  name               String
  amount             Int
  amountType         String    @default("FIXED") // FIXED | VARIABLE
  paymentMethod      String    @default("CASH_ACCOUNT") // CASH_ACCOUNT | CREDIT_CARD
  frequency          String
  config             String
  nonBusinessDayRule String    @default("NONE")
  useHolidays        Boolean   @default(true)
  startDate          String
  endDate            String?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashAccount CashAccount @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  expenses    Expense[]

  @@index([userId, isActive])
}

/// Gasto pagado con una cuenta de efectivo (RN-25). Siempre ligado a un movimiento.
model Expense {
  id                 String   @id @default(uuid())
  userId             String
  cashAccountId      String
  categoryId         String?
  recurringExpenseId String?
  cashMovementId     String   @unique
  description        String
  amount             Int
  expenseDate        String // "YYYY-MM-DD"
  occurrenceDate     String?
  status             String   @default("PAID") // PAID | REVERSED
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashAccount      CashAccount      @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  cashMovement     CashMovement     @relation(fields: [cashMovementId], references: [id], onDelete: Restrict)

  @@unique([recurringExpenseId, occurrenceDate])
  @@index([userId, expenseDate])
}

/// Tarjeta de credito del usuario. El saldo es cache del libro de la tarjeta.
/// RN-12: el corte es un dia fijo del mes (si no existe, el ultimo del mes).
/// RN-13: la fecha limite se calcula y se ajusta al dia habil anterior.
/// RN-14: la compra del dia del corte entra en ese corte (configurable).
model CreditCard {
  id                    String    @id @default(uuid())
  userId                String
  alias                 String
  institution           String
  last4                 String
  currency              String    @default("MXN")
  status                String    @default("ACTIVE") // ACTIVE | INACTIVE
  creditLimit           Int
  /// Cache del libro de la tarjeta, en centavos (positivo = deuda).
  currentBalance        Int       @default(0)
  availableCredit       Int       @default(0)
  balanceVersion        Int       @default(0)
  annualRateBps         Int       @default(0)
  annualFee             Int?
  annualFeeMonth        Int?
  cutDay                Int
  dueDateMode           String    @default("DAYS_AFTER_CUT") // FIXED_DAY | DAYS_AFTER_CUT
  dueDay                Int?
  dueDaysAfterCut       Int?
  dueNonBusinessDayRule String    @default("PREVIOUS") // PREVIOUS | NEXT | NONE
  sameDayCutIncluded    Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries    CardLedgerEntry[]
  statements CardStatement[]
  payments   CardPayment[]

  @@unique([userId, alias])
  @@index([userId, status])
}

/// Libro de la tarjeta: solo insercion. Positivo aumenta la deuda.
model CardLedgerEntry {
  id              String   @id @default(uuid())
  userId          String
  creditCardId    String
  statementId     String?
  reversesEntryId String?  @unique
  type            String // OPENING_BALANCE | PURCHASE | INSTALLMENT_PRINCIPAL | INTEREST | FEE | ANNUAL_FEE | PAYMENT | REFUND | ADJUSTMENT | REVERSAL
  amount          Int
  occurredOn      String // "YYYY-MM-DD"
  description     String
  sourceType      String?
  sourceId        String?
  createdById     String
  createdAt       DateTime @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard  CreditCard      @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  statement   CardStatement?  @relation(fields: [statementId], references: [id], onDelete: SetNull)
  reverses    CardLedgerEntry? @relation("CardEntryReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy  CardLedgerEntry? @relation("CardEntryReversal")
  cardPayment CardPayment?

  @@index([userId, creditCardId, occurredOn])
  @@index([sourceType, sourceId])
}

/// Estado de cuenta (corte). statementBalance = deuda total al corte.
model CardStatement {
  id                       String   @id @default(uuid())
  userId                   String
  creditCardId             String
  periodStart              String // "YYYY-MM-DD"
  cutDate                  String // "YYYY-MM-DD"
  dueDate                  String // "YYYY-MM-DD"
  statementBalance         Int
  cycleCharges             Int      @default(0)
  noInterestPaymentCalc    Int
  noInterestPaymentReported Int?
  minimumPaymentReported   Int?
  minimumPaymentEstimated  Int
  paidAmount               Int      @default(0)
  status                   String   @default("CLOSED") // OPEN | CLOSED | PAID | PARTIALLY_PAID | OVERDUE
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard  CreditCard       @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  entries     CardLedgerEntry[]
  payments    CardPayment[]
  allocations PaymentAllocation[]

  @@unique([creditCardId, cutDate])
  @@index([userId, dueDate])
  @@index([userId, status])
}

/// Pago de tarjeta financiado con una cuenta de efectivo.
model CardPayment {
  id                String   @id @default(uuid())
  userId            String
  creditCardId      String
  cashAccountId     String
  statementId       String?
  cashMovementId    String   @unique
  cardLedgerEntryId String   @unique
  amount            Int
  paymentDate       String // "YYYY-MM-DD"
  type              String   @default("STATEMENT") // STATEMENT | PARTIAL
  status            String   @default("APPLIED") // APPLIED | REVERSED
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard      CreditCard          @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  cashAccount     CashAccount         @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  statement       CardStatement?      @relation(fields: [statementId], references: [id], onDelete: SetNull)
  cashMovement    CashMovement        @relation(fields: [cashMovementId], references: [id], onDelete: Restrict)
  cardLedgerEntry CardLedgerEntry     @relation(fields: [cardLedgerEntryId], references: [id], onDelete: Restrict)
  allocations     PaymentAllocation[]

  @@index([userId, paymentDate])
}

/// Aplicacion de un pago: RN-23 (primero lo exigible del corte, luego el saldo).
model PaymentAllocation {
  id            String   @id @default(uuid())
  userId        String
  cardPaymentId String
  statementId   String?
  targetType    String // STATEMENT | INSTALLMENT | REVOLVING
  /// FK a Installment; se materializa en la Fase 5.
  installmentId String?
  amount        Int
  createdAt     DateTime @default(now())

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardPayment CardPayment    @relation(fields: [cardPaymentId], references: [id], onDelete: Cascade)
  statement   CardStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  @@index([cardPaymentId])
  @@index([statementId])
}
