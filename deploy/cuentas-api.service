# Unidad systemd para la API de Cuentas (NestJS + Fastify).
#
# Instalacion:
#   sudo cp deploy/cuentas-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cuentas-api
#   sudo systemctl status cuentas-api
#   journalctl -u cuentas-api -f
#
# Ajusta User/Group y WorkingDirectory si el proyecto no vive en /opt/cuentas-api.

[Unit]
Description=Cuentas API (NestJS + Fastify)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cuentas
Group=cuentas
WorkingDirectory=/opt/cuentas-api
EnvironmentFile=/opt/cuentas-api/.env
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5

# Endurecimiento basico
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
