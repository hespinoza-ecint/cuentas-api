# =============================================================================
# Cuentas API - Variables de entorno de ejemplo
# Copia este archivo a .env y ajusta los valores.
# =============================================================================

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Servidor
HOST=0.0.0.0
PORT=3000
APP_VERSION=0.1.0

# Base de datos SQLite.
# IMPORTANTE: colócala FUERA de OneDrive para evitar corrupción por sincronización.
# Windows: usa una ruta absoluta con diagonales normales (/), no diagonales invertidas.
# Ejemplo: DATABASE_URL=file:C:/Users/TuUsuario/AppData/Local/Cuentas/data/cuentas.db
DATABASE_URL=file:C:/Users/TuUsuario/AppData/Local/Cuentas/data/cuentas.db

# CORS: orígenes permitidos, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Nivel de logs: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# Documentación interactiva de la API (Swagger) en /api/docs
DOCS_ENABLED=true

# Límite global de peticiones por IP
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# -----------------------------------------------------------------------------
# Autenticación (Fase 2)
# -----------------------------------------------------------------------------

# Secreto para firmar los access tokens. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=coloca-aqui-un-secreto-de-al-menos-32-caracteres

# Vigencia de tokens
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Bloqueo de cuenta por intentos fallidos
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# Tokens de un solo uso
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# Límite de peticiones en rutas /auth/*
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=5

# URL de la PWA (para construir los enlaces de los correos)
WEB_APP_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Se agregarán en fases posteriores (Fase 3+):
# correo SMTP/SendGrid/Resend (en desarrollo los correos salen en el log)
# -----------------------------------------------------------------------------
