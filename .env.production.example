# =============================================================================
# Cuentas API - Ejemplo de configuracion para produccion
# Copia a .env.production en el servidor y ajusta los valores.
# =============================================================================

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_VERSION=1.0.0

# SQLite dentro del volumen de Docker (/data) o ruta absoluta del VPS.
DATABASE_URL=file:/data/cuentas.db

# Dominio real de la PWA
CORS_ORIGINS=https://app.tudominio.com

# Produccion no necesita logs de depuracion
LOG_LEVEL=info

# Apaga Swagger si el servidor es publico (o protegelo con el proxy)
DOCS_ENABLED=false

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=5

WEB_APP_URL=https://app.tudominio.com
