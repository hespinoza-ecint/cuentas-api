# =============================================================================
# Cuentas API - Configuracion de produccion (Docker o 3 maquinas)
# - Docker: copia como .env.production junto a docker-compose.yml (lo lee env_file).
# - Sin Docker: copia como .env en el servidor de la API.
# Ajusta sobre todo DATABASE_URL y JWT_SECRET.
# =============================================================================

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_VERSION=1.0.0

# --- Base de datos MySQL (servidor dedicado) ---------------------------------
# Formato: mysql://USUARIO:CONTRASENA@HOST_MYSQL:3306/cuentas
# Codifica los caracteres especiales de la contrasena (por ejemplo @ = %40).
DATABASE_URL=mysql://cuentas:contrasena@10.0.0.30:3306/cuentas

# Alternativa de una sola maquina (SQLite):
# DATABASE_URL=file:/var/lib/cuentas/cuentas.db

# --- Red, CORS y enlaces ------------------------------------------------------
# El navegador solo habla con el dominio del front; nginx reenvia /api aqui.
# Debe incluir el origen exacto del front (varios separados por coma).
CORS_ORIGINS=https://app.tudominio.com
WEB_APP_URL=https://app.tudominio.com

# --- Registro y documentacion -------------------------------------------------
LOG_LEVEL=info
DOCS_ENABLED=false

# --- Limites de peticiones ----------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=5

# --- Sesiones -----------------------------------------------------------------
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Autenticacion ------------------------------------------------------------
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# --- Respaldo SQLite (no aplica con MySQL; usa mysqldump) --------------------
# BACKUP_DIR=/var/backups/cuentas
# BACKUP_RETENTION=14
